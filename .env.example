# --- Datenbank (eigene Supabase-Instanz, nicht die von Scooly!) -------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nur für `npm run pruefe:datenbank`: damit lässt sich nachweisen, dass mit
# dem öffentlichen Schlüssel niemand an die Daten kommt. Sonst nicht nötig.
SUPABASE_ANON_KEY=

# --- Wächter ---------------------------------------------------------------
# Selbst gewürfeltes Geheimnis. Muss auch als GitHub-Secret CRON_SECRET liegen.
CRON_SECRET=
# Abstand zwischen zwei Messungen in Minuten - muss zum Cron passen.
# Muss zum Zeitplan in .github/workflows/waechter.yml passen - daraus rechnet
# rollup_day die Ausfallminuten. Steht hier 5, während real alle 30 Minuten
# gemessen wird, meldet die Seite ein Sechstel der echten Ausfallzeit.
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_MS=20000

# --- Öffentliche Adresse ---------------------------------------------------
PUBLIC_URL=https://status.scooly.dev

# --- Telegram (optional) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Resend --------------------------------------------------------------
# Ohne diesen Schlüssel lehnt das Abo-Formular ehrlich ab, statt eine
# Bestätigungsmail zu versprechen, die nie ankommt.
# Die Absenderdomain muss in Resend verifiziert sein (SPF, DKIM, DMARC).
RESEND_API_KEY=
RESEND_FROM=Scooly Status <status@scooly.dev>
# Höchstens so viele Meldungen bekommt eine Person am Tag. Die
# Bestätigungsmail zählt bewusst nicht mit.
MAIL_MAX_PRO_TAG=2
# Meldungen, die älter sind als das hier (Minuten), werden nur noch
# abgehakt statt verschickt. Schutz gegen einen Schwall alter Nachrichten,
# wenn der Wächter längere Zeit stillstand.
MELDE_FENSTER_MINUTEN=180
# Nur für Tests. Im Betrieb leer lassen.
# RESEND_API_URL=

# --- Nur lokal: Demodaten ohne Datenbank -----------------------------------
# STATUS_DEMO=1
# Demodaten zeigen sonst zwei laufende Störungen, damit man sieht, wie eine
# Beeinträchtigung aussieht. Mit =1 ist stattdessen alles grün.
# STATUS_DEMO_GRUEN=1
