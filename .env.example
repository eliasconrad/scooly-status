# --- Datenbank (eigene Supabase-Instanz, nicht die von Scooly!) -------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Wächter ---------------------------------------------------------------
# Selbst gewürfeltes Geheimnis. Muss auch als GitHub-Secret CRON_SECRET liegen.
CRON_SECRET=
# Abstand zwischen zwei Messungen in Minuten - muss zum Cron passen.
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_MS=20000

# --- Öffentliche Adresse ---------------------------------------------------
PUBLIC_URL=https://status.scooly.at

# --- Benachrichtigungen (beide optional) -----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM=Scooly Status <status@scooly.at>

# --- Nur lokal: Demodaten ohne Datenbank -----------------------------------
# STATUS_DEMO=1
